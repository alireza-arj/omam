{
  "name": "omam",
  "private": true,
  "packageManager": "bun@1.3.1",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.1.7",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.4.17"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run dev:mobile",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "web": "bun run --cwd apps/mobile web",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:api && bun run build:mobile",
    "build:api": "bun run --cwd apps/api build",
    "build:mobile": "bun run --cwd apps/mobile build",
    "build:android": "bun run --cwd apps/mobile build:android",
    "build:android:apk": "bun run --cwd apps/mobile build:android:apk",
    "build:android:aab": "bun run --cwd apps/mobile build:android:aab",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/mobile typecheck",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "db:migrate": "bun run --cwd apps/api db:migrate"
  }
}
