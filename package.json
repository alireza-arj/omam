{
  "name": "omam",
  "private": true,
  "packageManager": "bun@1.3.1",
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "^4.3.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "scripts": {
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:api && bun run build:mobile",
    "build:api": "bun run --cwd apps/api build",
    "build:mobile": "bun run --cwd apps/mobile build",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push"
  }
}
