{
  "name": "omam",
  "private": true,
  "packageManager": "bun@1.3.1",
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo-constants": "57.0.21"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run dev:mobile",
    "android": "bun run --cwd apps/mobile android",
    "ios": "bun run --cwd apps/mobile ios",
    "web": "bun run --cwd apps/mobile web",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "dev:api": "bun run --cwd apps/api dev",
    "build": "bun run build:api && bun run build:admin && bun run build:mobile",
    "build:api": "bun run --cwd apps/api build",
    "build:mobile": "bun run --cwd apps/mobile build",
    "build:android": "bun run --cwd apps/mobile build:android",
    "build:android:apk": "bun run --cwd apps/mobile build:android:apk",
    "build:android:aab": "bun run --cwd apps/mobile build:android:aab",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/admin typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd apps/desktop typecheck",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "dev:admin": "bun run --cwd apps/admin dev",
    "build:admin": "bun run --cwd apps/admin build",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:deploy": "bun run --cwd apps/api db:deploy",
    "test:smoke": "bun run --cwd apps/api test:smoke",
    "test": "bun test packages/calendar packages/i18n apps/mobile/src/lib/browser-database-access.test.ts apps/mobile/src/lib/session-lifecycle.test.ts apps/mobile/src/lib/sync/server-url.test.ts && bun run --cwd apps/desktop test",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "package:desktop": "bun run --cwd apps/desktop package",
    "package:desktop:local": "bun run --cwd apps/desktop package:local",
    "build:android:preview": "bun run --cwd apps/mobile build:android:preview",
    "update:android:preview": "bun run --cwd apps/mobile update:android:preview",
    "update:android:production": "bun run --cwd apps/mobile update:android:production"
  },
  "trustedDependencies": [
    "electron"
  ]
}
