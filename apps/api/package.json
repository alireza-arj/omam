{
  "name": "@omam/api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@elysiajs/cors": "*",
    "@omam/contracts": "file:../../packages/contracts",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "*",
    "dotenv": "^17.4.2",
    "elysia": "*",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "prisma": "*",
    "typescript": "*"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist --sourcemap",
    "start:prod": "bun run dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  }
}
