# PostgreSQL connection string. The API refuses to boot without it.
DATABASE_URL="postgresql://postgres@localhost:5432/omam?schema=public"

HOST=0.0.0.0
PORT=3001

# Dates are read in the host's local zone, so run the API in the team's zone.
TZ=Asia/Tehran

# Comma-separated origins allowed to call the API. "*" allows any origin.
CORS_ORIGINS=*

# Bootstrap organization and owner, created by `bun run db:seed`.
SEED_ORG_NAME="Omam Team"
SEED_ORG_SLUG="omam"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="changeme123"
