{
  "name": "@omam/mobile",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@omam/contracts": "file:../../packages/contracts",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.35",
    "expo-blur": "~15.0.8",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "*",
    "nativewind": "*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "*",
    "typescript": "*"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "expo export --platform all && bun run pwa:inject",
    "build:web": "expo export --platform web && bun run pwa:inject",
    "pwa:inject": "bun scripts/inject-pwa.mjs",
    "build:android": "bun run build:android:aab",
    "build:android:apk": "bunx eas-cli build -p android --profile preview",
    "build:android:aab": "bunx eas-cli build -p android --profile production",
    "build:android:dev": "bunx eas-cli build -p android --profile development",
    "build:ios": "bunx eas-cli build -p ios --profile production"
  }
}
