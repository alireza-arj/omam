{
  "name": "@omam/mobile",
  "private": true,
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/public-sans": "^0.4.2",
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@gorhom/bottom-sheet": "^5.2.9",
    "@omam/calendar": "workspace:*",
    "@omam/contracts": "workspace:*",
    "@omam/i18n": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "heroui-native": "1.0.9",
    "lucide-react-native": "*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.17",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.12",
    "typescript": "*"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "expo export --platform all && bun run pwa:inject",
    "build:web": "expo export --platform web && bun run pwa:inject",
    "pwa:inject": "bun scripts/inject-pwa.mjs",
    "build:android": "bun run build:android:aab",
    "build:android:apk": "bunx eas-cli build -p android --profile market",
    "build:android:aab": "bunx eas-cli build -p android --profile production",
    "build:android:dev": "bunx eas-cli build -p android --profile development",
    "build:ios": "bunx eas-cli build -p ios --profile production",
    "build:android:preview": "bunx eas-cli build -p android --profile preview",
    "update:android:preview": "bunx eas-cli update --channel preview --environment preview --platform android",
    "update:android:production": "bunx eas-cli update --channel production --environment production --platform android"
  }
}
