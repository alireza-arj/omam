{
  "expo": {
    "name": "Omam",
    "slug": "omam",
    "version": "1.0.0",
    "scheme": "omam",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Omam to access your photos so you can choose an avatar."
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Omam to access your photos so you can choose an avatar."
      }
    },
    "android": {
      "package": "com.omam.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#0B0E12"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07eaab54-f04d-4d17-9238-af7e95faab68"
      }
    },
    "owner": "codeali"
  }
}
