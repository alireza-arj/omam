{
  "expo": {
    "name": "Tarazkar",
    "slug": "omam",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/07eaab54-f04d-4d17-9238-af7e95faab68",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "omam",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/app-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tarazkar to access your photos so you can choose an avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-notifications",
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ],
            "enablePngCrunchInReleaseBuilds": true,
            "enableBundleCompression": true,
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Tarazkar to access your photos so you can choose an avatar."
      }
    },
    "android": {
      "package": "com.omam.app",
      "versionCode": 13,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon-foreground.png",
        "backgroundColor": "#0B0E12"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/app-icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07eaab54-f04d-4d17-9238-af7e95faab68"
      }
    },
    "owner": "codeali"
  }
}
