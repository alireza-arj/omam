# Recommended for local simulators/emulators (auto-resolves localhost/10.0.2.2 as needed):
EXPO_PUBLIC_API_PORT=3001
# Optional build-time API URL (users never enter a server address).
# Production web uses /api on its own origin; native and Electron use https://omam.ir/api.
# EXPO_PUBLIC_API_URL="http://localhost:3001"
# For development on a physical device, use your laptop's LAN address:
# EXPO_PUBLIC_API_URL="http://192.168.1.100:3001"
# For public domains behind Cloudflare or any TLS proxy, always use https://
# EXPO_PUBLIC_API_URL="https://api.example.com"
