# Recommended for local simulators/emulators (auto-resolves localhost/10.0.2.2 as needed):
EXPO_PUBLIC_API_PORT=3001
# Optional explicit API URL override:
# EXPO_PUBLIC_API_URL="http://localhost:3001"
# Current detected laptop LAN URL for physical-device testing:
# EXPO_PUBLIC_API_URL="http://192.168.1.157:3010"
# For public domains behind Cloudflare or any TLS proxy, always use https://
# EXPO_PUBLIC_API_URL="https://api.example.com"
