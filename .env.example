# Copy to .env before `docker compose up -d --build`.

POSTGRES_USER=tarazkar
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=tarazkar

# Run the stack in the team's timezone: it decides where a month ends.
TZ=Asia/Tehran

API_PORT=3001
ADMIN_PORT=8080

# Where the browser and the phones reach the API. Use https behind a proxy.
PUBLIC_API_URL=http://localhost:3001

# Origins allowed to call the API. Narrow this to the panel's URL in production.
CORS_ORIGINS=*

# The first organization and its owner, created by `bun run db:seed`.
SEED_ORG_NAME=Tarazkar Team
SEED_ORG_SLUG=tarazkar
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=change-this-password
